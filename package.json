{
  "name": "email-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Daily email triage + AI digest to Telegram. Runs on Mac mini via launchd.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/run.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --outfile=dist/run.cjs --sourcemap",
    "start": "node dist/run.cjs",
    "dev": "tsx src/run.ts",
    "dry-run": "tsx src/run.ts --dry-run",
    "test-connection": "tsx src/run.ts --test-connection",
    "test": "npm run test:unit && npm run test:integration && npm run test:implementation",
    "test:unit": "node --import tsx --test --test-concurrency=1 test/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "test:implementation": "npm run build && node --test --test-concurrency=1 test/implementation/*.test.mjs",
    "test:performance": "node --import tsx scripts/performance-local.ts",
    "test:performance:live": "node --import tsx scripts/performance-live.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.3.0",
    "imapflow": "^1.3.2",
    "mailparser": "^3.9.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
